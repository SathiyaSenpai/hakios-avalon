# HakiOS fragment: the cliffs family -- what is true of the SoC, whatever device it is in.
CONFIG_SOC="cliffs"

# Multi-core CPU cores (SM7675 has 8 Kryo cores: 3 Silver, 4 Gold, 1 Prime)
CONFIG_CPUS=8

# CPU Frequency Scaling (EPSS v2 @ 0x17d91000)
CONFIG_CPUFREQ=y
CONFIG_HAKIOS_CPUFREQ=y

# Core SoC identification (SMEM item 137)
CONFIG_SOCINFO=y
CONFIG_HAKIOS_SOCINFO=y

# Core Thermal (TSENS v2)
CONFIG_THERMAL=y
CONFIG_HAKIOS_THERMAL=y

# Buttons (PMIC Arbiter v7)
CONFIG_BUTTONS=y
CONFIG_HAKIOS_BUTTONS=y

# PMIC Arbiter v7 Bus & RTC counter
CONFIG_PMIC=y
CONFIG_HAKIOS_PMIC=y

# Battery status
CONFIG_BATTERY=y
CONFIG_HAKIOS_BATTERY=y
