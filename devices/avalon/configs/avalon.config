# HakiOS fragment: the OnePlus Nord 4 (avalon)
CONFIG_DEVICE="avalon"

# Framebuffer & Display
CONFIG_FB_HZ=120
CONFIG_FBSCALE=2
CONFIG_FB_THREADS=4
CONFIG_CA_VBL=1

# Multi-Core Kryo Cores (3 Silver, 4 Gold, 1 Prime)
CONFIG_CPUS=8
CONFIG_BOOTCPU=7

# CPU Frequency Scaling (EPSS v2 @ 0x17d91000) & DDR bandwidth vote
CONFIG_CPUFREQ=y
CONFIG_DDR=2
CONFIG_HAKIOS_CPUFREQ=y
# Core SoC identification (SMEM item 137)
CONFIG_SOCINFO=y
CONFIG_HAKIOS_SOCINFO=y

# Core Thermal (TSENS v2)
CONFIG_THERMAL=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_THERMAL_STOP=95

# Hardware Buttons (PMIC Arbiter v7)
CONFIG_BUTTONS=y
CONFIG_HAKIOS_BUTTONS=y

# PMIC Arbiter v7 Bus & RTC counter
CONFIG_PMIC=y
CONFIG_HAKIOS_PMIC=y

# Battery status
CONFIG_BATTERY=y
CONFIG_HAKIOS_BATTERY=y

# Safe UFS survey (read-only, no write)
CONFIG_UFS=2
CONFIG_HAKIOS_UFS=y

# Touchscreen (Synaptics S3910 on SPI SE4)
CONFIG_TOUCHSCREEN=y
CONFIG_HAKIOS_S3910=y
CONFIG_TOUCH_DEBUG=y
# CONFIG_HAKIOS_GOODIX is not set

# Adreno GPU & Metal Accelerator
CONFIG_GPU=y
CONFIG_HAKIOS_ADRENO=y
CONFIG_METAL=1
CONFIG_METAL_FPS=y
# CONFIG_ADSP is not set
CONFIG_HAKIOS_ADSP=y
# CONFIG_SOUND is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_MIC is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_WIFI is not set
CONFIG_HAKIOS_WIFI=y
CONFIG_HAKIOS_QMI=y
CONFIG_MODEM=y
CONFIG_HAKIOS_MODEM=y
# CONFIG_MODEM_AGAIN is not set
CONFIG_MODEM_BUFFER=0x99900000
CONFIG_MODEM_VERBOSE=y
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# Haptic feedback (Awinic AW86927 on QUPv3 SE3 I2C @ 0x5a)
CONFIG_HAPTIC=5
CONFIG_HAKIOS_HAPTIC=y
CONFIG_HAKIOS_BT=y
CONFIG_BT=1
CONFIG_HAKIOS_BATTGUARD=y
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set

CONFIG_FIRMWARE="device"
